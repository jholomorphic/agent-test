{
  "name": "agent-test",
  "private": true,
  "version": "0.2.0",
  "description": "Private company agent operations system — simulation lab",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "dev": "pnpm --filter @agent-test/desktop dev",
    "dev:web": "pnpm --filter @agent-test/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx scripts/run-evals.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri:build": "pnpm --filter @agent-test/desktop tauri:build",
    "desktop:build": "pnpm --filter @agent-test/desktop build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
