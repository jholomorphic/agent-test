{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Test",
  "version": "0.1.0",
  "identifier": "com.agenttest.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @agent-test/desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @agent-test/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Test",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
